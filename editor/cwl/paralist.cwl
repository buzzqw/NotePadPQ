# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Compact and inline lists
# package: paralist
\begin{compactitem}[options]#D{Compact bulleted list}
\begin{compactenum}[options]#D{Compact numbered list}
\begin{compactdesc}[options]#D{Compact description list}
\begin{asparaitem}[options]#D{Item list in paragraph form}
\begin{asparaenum}[options]#D{Numbered list in paragraph form}
\begin{asparadesc}[options]#D{Description list in paragraph form}
\begin{inparaitem}[options]#D{Item list inside a paragraph}
\begin{inparaenum}[options]#D{Numbered list inside a paragraph}
\begin{inparadesc}[options]#D{Description list inside a paragraph}
\setdefaultitem{label}{...}#D{Set default item labels}
\setdefaultenum{label}{...}#D{Set default enumeration labels}
\setdefaultdesc{label}{...}#D{Set default description labels}
\setdefaultleftmargin{...}#D{Set default list margins}
