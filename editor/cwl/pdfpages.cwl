# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Include pages from PDF files
# package: pdfpages
\includepdf[options]{file}#D{Include pages from a PDF}
\includepdfmerge[options]{file-list}#D{Merge pages from several PDFs}
\includepdfset{options}#D{Set default pdfpages options}

#keyvals:\includepdf,\includepdfmerge,\includepdfset
pages=
nup=
landscape
portrait
frame
noautoscale
scale=
offset=
delta=
rotate=
trim=
clip
pagecommand=
signature=
signature*=
lastpage=
#endkeyvals
