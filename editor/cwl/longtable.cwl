# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Tables spanning multiple pages
# package: longtable
\begin{longtable}[position]{columns}#D{Table that can break across pages}
\endfirsthead#D{End of the first header}
\endhead#D{End of the repeated header}
\endfoot#D{End of the repeated footer}
\endlastfoot#D{End of the last footer}
\LTleft#D{Alignment of the table on the left}
\LTright#D{Alignment of the table on the right}
\LTpre#D{Space before the table}
\LTpost#D{Space after the table}
\LTcapwidth#D{Width of the table caption}
\setlongtables#D{Enable longtable mode}
