# description: References with page information
# package: varioref
\vref{label}#D{Reference with page information}
\Vref{label}#D{Reference with page information at the start of a sentence}
\vpageref{label}#D{Page reference with a relative description}
\vrefrange{first}{last}#D{Reference range with page information}
\Vrefrange{first}{last}#D{Reference range with page information at the start of a sentence}
\vpagerefrange{first}{last}#D{Page range with a relative description}
\fullref{label}#D{Reference with the full type name}
\Ref{label}#D{Capitalised reference}
\labelformat{type}{format}#D{Set the reference format for a type}
