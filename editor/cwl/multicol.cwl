# description: Multiple text columns
# package: multicol
\begin{multicols}{columns}[preface]#D{Balanced multi-column layout}
\begin{multicols*}{columns}[preface]#D{Multi-column layout without balancing}
\columnbreak#D{Start the next column}
\raggedcolumns#D{Do not balance the last column}
\flushcolumns#D{Balance the columns}
\multicolsep#D{Space before and after the columns}
\multicoltolerance#D{Paragraph tolerance inside columns}
\multicolpretolerance#D{Pre-tolerance inside columns}
