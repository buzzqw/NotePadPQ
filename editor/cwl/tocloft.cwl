# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Table of contents formatting
# package: tocloft
\cftsetindents{entry}{indent}{number width}#D{Set entry indentation}
\cftsetrmarg{length}#D{Set the right margin for wrapped entries}
\cftsetpnumwidth{length}#D{Set the page-number width}
\cftdot{character}#D{Set the leader character}
\cftdotfill{separation}#D{Fill the leader with dots}
\cftchapfont#D{Font for chapter entries}
\cftchappagefont#D{Font for chapter page numbers}
\cftchapleader#D{Leader for chapter entries}
\cftsecleader#D{Leader for section entries}
\cftchapdotsep#D{Dot separation for chapter entries}
\cftsecdotsep#D{Dot separation for section entries}
