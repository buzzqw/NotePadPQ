    {"regex": "^(?:export\\s+)?function\\s+(\\w+)\\s*\\(", "kind": "function", "name_group": 1, "icon": "𝑓", "level": 0},
    {"regex": "^(?:export\\s+)?(?:const|let|var)\\s+(\\w+)\\s*=\\s*(?:async\\s+)?(?:function|\\()", "kind": "arrow/fn", "name_group": 1, "icon": "𝑓", "level": 0},
    {"regex": "^  (?:async\\s+)?(?:get |set )?(\\w+)\\s*\\([^)]*\\)\\s*\\{", "kind": "method", "name_group": 1, "icon": "⚙", "level": 0}
  ]
}
