# description: Mathematical physics notation
# package: physics
\abs{x}#D{Absolute value}
\norm{x}#D{Norm}
\qty{value}#D{Delimited expression}
\qty(value)#D{Parenthesised expression}
\qty[value]#D{Bracketed expression}
\dv{f}{x}#D{Ordinary derivative}
\dv[n]{f}{x}#D{Derivative of order n}
\pdv{f}{x}#D{Partial derivative}
\derivative{f}{x}#D{Derivative with an explicit notation}
\partialderivative{f}{x}#D{Partial derivative with an explicit notation}
\grad#D{Gradient operator}
\div#D{Divergence operator}
\curl#D{Curl operator}
\laplacian#D{Laplacian operator}
\vb{v}#D{Bold vector}
\va{a}#D{Bold vector with an arrow}
\vu{u}#D{Unit vector}
\vdot#D{Vector dot product}
\cross#D{Vector cross product}
\expval{A}#D{Expectation value}
\matrixel{a}{A}{b}#D{Matrix element}
\bra{\psi}#D{Bra}
\ket{\psi}#D{Ket}
\braket{a}{b}#D{Bra-ket}
\mel{a}{A}{b}#D{Matrix element}
