# package: amsmath
\dfrac{numerator}{denominator}#D{Display-style fraction}
\tfrac{numerator}{denominator}#D{Text-style fraction}
\text{text}#D{Text inside math mode}
\operatorname{name}#D{Named math operator}
\begin{align}#D{Aligned equations}
\begin{align*}#D{Unnumbered aligned equations}
\begin{gather}#D{Gathered equations}
\begin{multline}#D{Multiline equation}
