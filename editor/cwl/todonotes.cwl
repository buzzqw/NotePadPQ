# description: TODO notes and missing figures
# package: todonotes
\todo[options]{text}#D{Add a TODO note}
\todo[inline]{text}#D{Add an inline TODO note}
\missingfigure{text}#D{Placeholder for a missing figure}
\listoftodos[title]#D{Print the list of TODO notes}
\todototoc#D{Add the TODO list to the table of contents}

#keyvals:\todo
color=
size=
inline
line
backgroundcolor=
bordercolor=
textcolor=
author=
tickmarkheight=
#endkeyvals
