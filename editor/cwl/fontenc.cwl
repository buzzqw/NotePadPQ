# description: Font encodings
# package: fontenc
\fontencoding{encoding}#D{Select a font encoding}
\DeclareFontEncoding{encoding}{text settings}{math settings}#D{Declare a font encoding}
\DeclareFontEncodingDefaults{text settings}{math settings}#D{Set encoding defaults}
\DeclareFontSubstitution{encoding}{family}{series}{shape}#D{Set the default font for an encoding}
\UseTextAccent{encoding}{accent}{character}#D{Use a text accent from an encoding}
\UseTextSymbol{encoding}{symbol}#D{Use a text symbol from an encoding}
