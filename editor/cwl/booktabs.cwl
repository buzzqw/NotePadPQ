# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Professional table rules
# package: booktabs
\toprule[width]#D{Top rule of a table}
\midrule[width]#D{Middle rule of a table}
\bottomrule[width]#D{Bottom rule of a table}
\cmidrule[width](trim){columns}#D{Partial rule spanning selected columns}
\addlinespace[width]#D{Extra space between rows}
\specialrule{width}{above}{below}#D{Custom rule with explicit spacing}
\morecmidrules#D{Allow another partial rule on the same row}
\heavyrulewidth#D{Width of top and bottom rules}
\lightrulewidth#D{Width of middle rules}
\cmidrulewidth#D{Width of partial rules}
\aboverulesep#D{Space above a rule}
\belowrulesep#D{Space below a rule}
