% npq-draft.sty — NotePadPQ Draft Mode Optimizer
% Caricato automaticamente da NotePadPQ quando il Draft Mode e' attivo.
% Non richiede modifiche al tuo documento.
%
% La flag \ifnpqdraft viene impostata da NotePadPQ prima di caricare
% questo file. Se non e' impostata, il file non fa nulla.
\newif\ifnpqdraft
\ifnpqdraft\else\endinput\fi

\PackageInfo{npq-draft}{NotePadPQ Draft Mode: fast compilation}

% --- microtype: disabilita protrusione/espansione (piu' veloce) ---
\PassOptionsToPackage{protrusion=false,expansion=false,tracking=false}{microtype}

% --- graphicx: placeholder invece di immagini ---
\PassOptionsToPackage{draft}{graphicx}

% --- hyperref: niente bordi colorati ---
\PassOptionsToPackage{draft}{hyperref}

% --- minted: niente syntax highlight ---
\PassOptionsToPackage{draft}{minted}

% --- listing: niente colori ---
\PassOptionsToPackage{draft}{listings}

% --- Spaziatura veloce ---
\sloppy

% --- Penalty bassi: non perdere tempo con vedove/orfane ---
\widowpenalty=150
\clubpenalty=150
