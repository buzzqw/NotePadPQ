# description: Underlining and text decorations
# package: ulem
\uline{text}#D{Underline text}
\uuline{text}#D{Double underline text}
\uwave{text}#D{Underline text with a wave}
\sout{text}#D{Strike through text}
\xout{text}#D{Cross out text}
\dashuline{text}#D{Underline text with dashes}
\dotuline{text}#D{Underline text with dots}
\ULforem#D{Use emphasis instead of underlining}
