# description: Additional mathematical symbols
# package: amssymb
\mathbb{R}#D{Blackboard bold letter}
\mathcal{A}#D{Calligraphic letter}
\mathfrak{g}#D{Fraktur letter}
\mathscr{F}#D{Script letter}
\mathbf{v}#D{Bold math symbol}
\mathrm{d}#D{Roman math symbol}
\mathit{text}#D{Italic math text}
\mathsf{text}#D{Sans-serif math text}
\mathtt{text}#D{Monospaced math text}
\boldsymbol{\alpha}#D{Bold Greek or symbol}
\pmb{text}#D{Poor man's bold}
\Box#D{Square box}
\square#D{Square box}
\blacksquare#D{Filled square}
\checkmark#D{Check mark}
\nexists#D{Does not exist}
\varnothing#D{Empty set}
\emptyset#D{Empty set}
\leqslant#D{Less than or equal}
\geqslant#D{Greater than or equal}
\nleq#D{Not less than or equal}
\ngeq#D{Not greater than or equal}
\subsetneq#D{Proper subset, not equal}
\supsetneq#D{Proper superset, not equal}
\therefore#D{Therefore}
\because#D{Because}
\implies#D{Implies}
\impliedby#D{Implied by}
\iff#D{If and only if}
\nmid#D{Does not divide}
\parallel#D{Parallel}
\nparallel#D{Not parallel}
\cong#D{Congruent}
\simeq#D{Asymptotically equal}
\asymp#D{Asymptotic}
\prec#D{Precedes}
\succ#D{Succeeds}
\preceq#D{Precedes or equals}
\succeq#D{Succeeds or equals}
\ll#D{Much less than}
\gg#D{Much greater than}
\in#D{Element of}
\notin#D{Not an element of}
\ni#D{Contains as element}
\aleph#D{Aleph}
\hbar#D{Reduced Planck constant}
\ell#D{Script l}
\Re#D{Real part}
\Im#D{Imaginary part}
\wp#D{Weierstrass p}
\angle#D{Angle}
\measuredangle#D{Measured angle}
\triangle#D{Triangle}
\triangleq#D{Defined as}
\bigstar#D{Filled star}
\diamond#D{Diamond}
\clubsuit#D{Club suit}
\spadesuit#D{Spade suit}
\heartsuit#D{Heart suit}
\diamondsuit#D{Diamond suit}
