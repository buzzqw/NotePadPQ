# description: Custom floats and placement
# package: float
\floatstyle{style}#D{Select the float style}
\restylefloat{float}#D{Apply the current style to a float}
\floatname{float}{name}#D{Set the float name}
\floatplacement{float}{placement}#D{Set the default placement}
\listof{float}{title}#D{Print a list of floats}
\newfloat{type}{placement}{extension}{title}#D{Define a new float}

#keyvals:\floatstyle
plain
boxed
ruled
#endkeyvals
