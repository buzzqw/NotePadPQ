# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Context-sensitive quotation marks
# package: csquotes
\enquote{text}#D{Quote text using the current style}
\enquote*{text}#D{Quote text using the alternative style}
\blockquote[cite]{text}#D{Block quotation}
\blockcquote[cite]{text}#D{Block quotation with a citation}
\foreignquote{language}{text}#D{Quote in a foreign language}
\hyphenquote{language}{text}#D{Quote in a foreign language with hyphenation}
\textquote[cite]{text}#D{Inline quotation}
\MakeAutoQuote{opening}{closing}#D{Define automatic quotation marks}
\MakeForeignQuote{language}{opening}{closing}#D{Define foreign quotation marks}
\setquotestyle{style}#D{Select a quotation style}
