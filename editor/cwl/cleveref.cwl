# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Automatic cross-reference names
# package: cleveref
\cref{label}#D{Reference with an automatic type name}
\Cref{label}#D{Reference with a capitalised type name}
\crefrange{first}{last}#D{Reference range}
\Crefrange{first}{last}#D{Reference range with a capitalised type name}
\cpageref{label}#D{Page reference}
\Cpageref{label}#D{Page reference with a capitalised "Page"}
\labelcref{label}#D{Reference using only the label text}
\namecref{label}#D{Type name of a reference}
\nameCref{label}#D{Capitalised type name of a reference}
\lcnamecref{label}#D{Lower-case type name of a reference}
\crefname{type}{singular}{plural}#D{Set the type name used by cleveref}
\Crefname{type}{singular}{plural}#D{Set the capitalised type name}
\creflabelformat{type}{format}#D{Format the label part of a reference}
\crefmultiformat{type}{first}{middle}{last}{pair}#D{Format multiple references}
\crefrangemultiformat{type}{first}{middle}{last}{pair}#D{Format multiple reference ranges}
\crefformat{type}{format}#D{Format a single reference}
\Crefformat{type}{format}#D{Format a single capitalised reference}
\crefrangeformat{type}{format}#D{Format a reference range}
\Crefrangeformat{type}{format}#D{Format a capitalised reference range}
