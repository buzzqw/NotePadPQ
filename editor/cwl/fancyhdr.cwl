# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Headers and footers
# package: fancyhdr
\fancyhead[positions]{text}#D{Header field}
\fancyfoot[positions]{text}#D{Footer field}
\fancyhf[positions]{text}#D{Header or footer field}
\lhead{text}#D{Left header}
\chead{text}#D{Centre header}
\rhead{text}#D{Right header}
\lfoot{text}#D{Left footer}
\cfoot{text}#D{Centre footer}
\rfoot{text}#D{Right footer}
\pagestyle{style}#D{Set the page style}
\thispagestyle{style}#D{Set the page style for this page only}
\fancypagestyle{name}{code}#D{Define a custom page style}
\headrulewidth#D{Width of the header rule}
\footrulewidth#D{Width of the footer rule}
\headruleskip#D{Vertical space before the header rule}
\footruleskip#D{Vertical space before the footer rule}
