# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: OpenType and system fonts
# package: fontspec
\setmainfont[options]{font}#D{Set the main font}
\setsansfont[options]{font}#D{Set the sans-serif font}
\setmonofont[options]{font}#D{Set the monospaced font}
\newfontfamily{\name}[options]{font}#D{Define a new font family}
\newfontface{\name}[options]{font}#D{Define a new font face}
\setfontfamily{\name}[options]{font}#D{Set a font family command}
\fontspec[options]{font}#D{Select a font}
\addfontfeatures{options}#D{Add OpenType features}
\addfontfeature{options}#D{Add one OpenType feature}
\defaultfontfeatures{options}#D{Set default font features}
\setmathrm{font}#D{Set the roman math font}
\setmathsf{font}#D{Set the sans-serif math font}
\setmathtt{font}#D{Set the monospaced math font}

#keyvals:\setmainfont,\setsansfont,\setmonofont,\newfontfamily,\newfontface,\fontspec
Path=
Extension=
UprightFont=
BoldFont=
ItalicFont=
BoldItalicFont=
SmallCapsFont=
Scale=
Ligatures=
Numbers=
Style=
Contextuals=
CharacterVariant=
StylisticSet=
#endkeyvals
