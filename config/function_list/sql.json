    {"regex": "(?i)^CREATE\\s+(?:OR\\s+REPLACE\\s+)?VIEW\\s+(\\w+)", "kind": "view", "name_group": 1, "icon": "👁", "level": 0},
    {"regex": "(?i)^CREATE\\s+TABLE\\s+(?:IF\\s+NOT\\s+EXISTS\\s+)?(\\w+)", "kind": "table", "name_group": 1, "icon": "🗃", "level": 0},
    {"regex": "(?i)^CREATE\\s+INDEX\\s+(?:IF\\s+NOT\\s+EXISTS\\s+)?(\\w+)", "kind": "index", "name_group": 1, "icon": "·", "level": 0}
