# NotePadPQ original completion data — see README.md
# SPDX-License-Identifier: EUPL-1.2
# description: Letter spacing and highlighting
# package: soul
\so{text}#D{Letter-spaced text}
\ul{text}#D{Underlined text}
\st{text}#D{Struck-through text}
\hl{text}#D{Highlighted text}
\caps{text}#D{Small capitals}
\lowercase{text}#D{Lower-case text}
\soulregister{command}{arguments}#D{Register a command for soul}
\soulaccent{character}#D{Declare an accent for soul}
