# description: Coloured table cells and rules
# package: colortbl
\rowcolor[model]{color}#D{Colour the current row}
\columncolor[model]{color}#D{Colour the current column}
\cellcolor[model]{color}#D{Colour the current cell}
\arrayrulecolor{color}#D{Set the colour of table rules}
\doublerulesepcolor{color}#D{Set the colour between double rules}
\rowcolors[commands]{row}{odd color}{even color}#D{Alternate row colours}
