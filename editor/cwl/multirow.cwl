# description: Vertical cell merging
# package: multirow
\multirow[options]{rows}{width}{text}#D{Merge cells vertically}
\multirowcell[options]{rows}{text}#D{Merge cells with a specified number of rows}
\multirowsetup#D{Apply default options to following multirow commands}

#keyvals:\multirow,\multirowcell
vpos#t,c,b
vmove=
bigstruts=
fixup=
#endkeyvals
