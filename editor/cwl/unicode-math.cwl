# description: OpenType math fonts and symbols
# package: unicode-math
\setmathfont[options]{font}#D{Select the math font}
\setmathfontface{\name}{font}#D{Define a math font face}
\setoperatorfont{font}#D{Set the operator font}
\symbf{math}#D{Bold math}
\symit{math}#D{Italic math}
\symrm{math}#D{Roman math}
\symup{math}#D{Upright math}
\symcal{math}#D{Calligraphic math}
\symscr{math}#D{Script math}
\symfrak{math}#D{Fraktur math}
\symbb{math}#D{Blackboard-bold math}
\symsf{math}#D{Sans-serif math}
\symtt{math}#D{Monospaced math}
\symbfit{math}#D{Bold italic math}
\symbfsf{math}#D{Bold sans-serif math}
\symbfcal{math}#D{Bold calligraphic math}
\symbffrak{math}#D{Bold Fraktur math}
\symbfbb{math}#D{Bold blackboard-bold math}
\symsfup{math}#D{Sans-serif upright math}
\symbfup{math}#D{Bold upright math}

#keyvals:\setmathfont
Path=
Extension=
Scale=
Ligatures=
StylisticSet=
CharacterVariant=
